VITE_RAWG_KEY=your_rawg_key_here

# Server-side only (read via process.env in api/*.js) — do NOT prefix with VITE_,
# that would bundle them into the client-side JS.
MISTRAL_API_KEY=your_mistral_key_here
# Optional fallback game-data source if RAWG has gaps (see PLAN.md Phase 5).
IGDB_CLIENT_ID=your_twitch_client_id_here
IGDB_CLIENT_SECRET=your_twitch_client_secret_here
